#!/usr/bin/env python3
import argparse
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from typing import Dict, List, Optional


VERSION = '1.1.0'

# The timestamp format is configurable in BIRD, so preserve it verbatim.
SUMMARY_RE = re.compile(
    r'^(?P<name>\S+)\s+(?P<proto>\S+)\s+(?P<table>\S+)\s+'
    r'(?P<state>up|down|start|stop|flush|feed|happy|hungry)\s+'
    r'(?P<since>.+?)(?:\s{2,}(?P<info>.*))?$', re.IGNORECASE
)


class BirdError(Exception):
    """A birdc failure that can be shown without a Python traceback."""


def peer_state(row):
    if row.get('bgp_state'):
        return row['bgp_state'].lower()
    info = row.get('info', '').split(' ', 1)[0].lower()
    if info in ('established', 'idle', 'connect', 'active', 'opensent', 'openconfirm'):
        return info
    return row.get('state', '').lower()


STATE_ORDER = {
    'established': 0,
    'up': 0,
    'connect': 1,
    'active': 2,
    'idle': 3,
    'start': 4,
}

COLORS = {
    'reset': '\033[0m',
    'bold': '\033[1m',
    'dim': '\033[2m',
    'cyan': '\033[36m',
    'red': '\033[31m',
    'green': '\033[32m',
    'yellow': '\033[33m',
}


def resolve_birdc(explicit=None) -> str:
    override = explicit or os.environ.get('BIRDC')
    candidates = [override] if override else ['birdc', '/usr/sbin/birdc', '/usr/local/sbin/birdc']
    for candidate in candidates:
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    raise BirdError('Could not find birdc. Set BIRDC=/path/to/birdc or use --birdc PATH.')


def run(cmd: List[str], timeout: float = 10) -> str:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise BirdError(f'birdc timed out after {timeout:g}s. Check the daemon or use --timeout.') from None
    except OSError as exc:
        raise BirdError(f'Could not run birdc: {exc}') from None
    if p.returncode != 0:
        raise BirdError((p.stderr or p.stdout).strip() or f'birdc exited with status {p.returncode}')
    # BIRD can report command errors while birdc itself exits successfully.
    error = re.search(r'(?mi)^(?:syntax error|Access denied|No such command|Unknown command)\b.*', p.stdout)
    if error:
        raise BirdError(error.group(0))
    return p.stdout


def strip_banner(text: str) -> str:
    lines = text.splitlines()
    out = []
    for line in lines:
        if line.startswith('BIRD ') and 'ready.' in line:
            continue
        if line.strip() == 'Access restricted':
            continue
        out.append(line)
    return '\n'.join(out).strip('\n')


def human_name(name: str) -> str:
    s = name
    s = re.sub(r'_AS(\d+)_v([46])$', r' AS\1 v\2', s)
    s = re.sub(r'_AS(\d+)$', r' AS\1', s)
    s = s.replace('_', ' ')
    return s


def colorize(text: str, color: str, enabled: bool) -> str:
    if not enabled:
        return text
    return f"{COLORS[color]}{text}{COLORS['reset']}"


def status_label(state: str) -> str:
    s = (state or '').lower()
    if s == 'established':
        return 'UP'
    if s:
        return s.upper()
    return '-'


def parse_protocol(text: str) -> Dict[str, str]:
    """Parse the indented detail block for one protocol."""
    data = {
        'description': '',
        'bgp_state': '',
        'neighbor': '',
        'neighbor_as': '',
        'source': '',
        'last_error': '',
        'connect_delay': '',
        'imported': '0',
        'exported': '0',
        'preferred': '0',
        'channels': '',
    }

    channels = []
    imported_total = 0
    exported_total = 0
    preferred_total = 0
    current_channel = None

    for raw in text.splitlines():
        s = raw.strip()

        m = re.match(r'Description:\s+(.*)', s)
        if m:
            data['description'] = m.group(1).strip()
            continue

        m = re.match(r'BGP state:\s+(.*)', s)
        if m:
            data['bgp_state'] = m.group(1).strip()
            continue

        m = re.match(r'Neighbor address:\s+(.*)', s)
        if m:
            data['neighbor'] = m.group(1).strip()
            continue

        m = re.match(r'Neighbor AS:\s+(.*)', s)
        if m:
            data['neighbor_as'] = m.group(1).strip()
            continue

        m = re.match(r'Source address:\s+(.*)', s)
        if m:
            data['source'] = m.group(1).strip()
            continue

        m = re.match(r'Last error:\s+(.*)', s)
        if m:
            data['last_error'] = m.group(1).strip()
            continue

        m = re.match(r'Connect delay:\s+(.*)', s)
        if m:
            data['connect_delay'] = m.group(1).strip()
            continue

        m = re.match(r'Channel\s+(\S+)', s)
        if m:
            current_channel = m.group(1)
            channels.append(current_channel)
            continue

        m = re.match(r'Routes:\s+(.*)', s)
        if m and current_channel:
            body = m.group(1)
            mi = re.search(r'(\d+)\s+imported', body)
            me = re.search(r'(\d+)\s+exported', body)
            mp = re.search(r'(\d+)\s+preferred', body)
            if mi:
                imported_total += int(mi.group(1))
            if me:
                exported_total += int(me.group(1))
            if mp:
                preferred_total += int(mp.group(1))
            continue

    data['imported'] = str(imported_total)
    data['exported'] = str(exported_total)
    data['preferred'] = str(preferred_total)
    data['channels'] = ','.join(channels)
    return data


def summarize_detail(r: Dict[str, str]) -> str:
    parts = []
    desc = (r.get('description') or '').strip()
    if desc:
        parts.append(desc)

    state = peer_state(r)
    err = (r.get('last_error') or '').strip()
    delay = (r.get('connect_delay') or '').strip()

    if state == 'established':
        if r.get('source'):
            parts.append(f"src {r['source']}")
    else:
        if err:
            parts.append(err)
        elif r.get('info'):
            parts.append(r['info'])
        if delay:
            parts.append(f"retry {delay}")

    if not parts and r.get('info'):
        parts.append(r['info'])

    deduped = []
    seen = set()
    for p in parts:
        if p not in seen:
            deduped.append(p)
            seen.add(p)
    return ' | '.join(deduped)


def parse_snapshot(text: str) -> List[Dict[str, str]]:
    """Parse one show protocols all response, keeping protocol blocks separate."""
    rows = []
    current = None
    details = []
    saw_header = False

    def finish():
        if current and current['proto'] == 'BGP':
            row = {**current, **parse_protocol('\n'.join(details))}
            row['pretty_name'] = human_name(row['name'])
            row['detail'] = summarize_detail(row)
            rows.append(row)

    for line in strip_banner(text).splitlines():
        if re.match(r'^Name\s+Proto\s+', line):
            saw_header = True
            continue
        if line and not line[0].isspace():
            match = SUMMARY_RE.match(line.rstrip())
            if not match:
                raise BirdError(f'Unrecognised birdc output: {line[:160]}')
            finish()
            current = match.groupdict(default='')
            details = []
        elif current:
            details.append(line)
    finish()
    if not saw_header and current is None:
        raise BirdError('No protocol table returned by birdc. Check the daemon and socket.')
    return rows


def collect_rows(args) -> List[Dict[str, str]]:
    cmd = [resolve_birdc(args.birdc), '-r']
    if args.socket:
        cmd += ['-s', args.socket]
    cmd += ['show', 'protocols', 'all']
    rows = parse_snapshot(run(cmd, args.timeout))
    if args.match:
        needle = args.match.casefold()
        fields = ('name', 'pretty_name', 'neighbor', 'neighbor_as', 'description', 'detail')
        rows = [r for r in rows if needle in ' '.join(r.get(k, '') for k in fields).casefold()
                or needle == 'as' + r.get('neighbor_as', '').casefold()]
    if args.up:
        rows = [r for r in rows if peer_state(r) == 'established']
    if args.down:
        rows = [r for r in rows if peer_state(r) != 'established']
    if args.sort in ('imported', 'exported'):
        key = lambda r: (-int(r[args.sort]), r['name'])
    elif args.sort == 'asn':
        key = lambda r: (int(r['neighbor_as']) if r['neighbor_as'].isdigit() else -1, r['name'])
    elif args.sort == 'name':
        key = lambda r: r['name'].casefold()
    else:
        key = lambda r: (STATE_ORDER.get(peer_state(r), 99), r['name'])
    return sorted(rows, key=key)


def fit(text: str, width: int) -> str:
    if width <= 0:
        return ''
    if len(text) <= width:
        return text
    if width <= 1:
        return text[:width]
    return text[: width - 1] + '…'


def terminal_text(value):
    # Descriptions and errors originate in daemon output; keep control codes out
    # of terminal cells (JSON retains the original values, escaped by json.dumps).
    return ''.join(c if c.isprintable() else ' ' for c in str(value))


def display_detail(row, details=False):
    if details:
        return row.get('detail') or '-'
    if peer_state(row) == 'established':
        return row.get('description') or '-'
    # Put the problem first so a long description cannot hide it.
    parts = [row.get('last_error') or row.get('info')]
    if row.get('connect_delay'):
        parts.append(f"retry {row['connect_delay']}")
    if row.get('description'):
        parts.append(row['description'])
    return ' | '.join(p for p in parts if p) or '-'


def render_rows(rows: List[Dict[str, str]], color: bool, compact: bool, details: bool = False) -> str:
    term_width = max(1, shutil.get_terminal_size((180, 40)).columns)
    compact = compact or term_width < 150
    headers = (['NAME', 'PEER', 'STATE', 'IN', 'OUT', 'DETAIL'] if compact else
               ['NAME', 'NEIGHBOR', 'ASN', 'AF', 'STATE', 'IMPORTED', 'EXPORTED', 'SINCE', 'DETAIL'])
    raw = []
    for r in rows:
        peer = r.get('neighbor') or '-'
        if compact and r.get('neighbor_as'):
            peer += f" AS{r['neighbor_as']}"
        cells = [r['pretty_name'], peer]
        if not compact:
            cells.append(f"AS{r['neighbor_as']}" if r.get('neighbor_as') else '-')
            cells.append(r.get('channels') or '-')
        cells += [status_label(peer_state(r)), f"{int(r.get('imported', '0')):,}",
                  f"{int(r.get('exported', '0')):,}"]
        if not compact:
            cells.append(r.get('since') or '-')
        cells.append(display_detail(r, details))
        raw.append([terminal_text(c) for c in cells])
    widths = [max([len(h)] + [len(r[i]) for r in raw]) for i, h in enumerate(headers)]
    caps = [30, 44, 13, 16, 16, 80] if compact else [30, 39, 12, 16, 13, 16, 16, 26, 80]
    widths = [min(w, cap) for w, cap in zip(widths, caps)]
    # Spend spare space on details, then shrink details/name/peer as necessary.
    widths[-1] = max(len(headers[-1]), term_width - sum(widths[:-1]) - 2 * (len(headers) - 1))
    minimums = [min(len(h), w) for h, w in zip(headers, widths)]
    for i in [len(widths) - 1, 0, 1] + list(range(2, len(widths) - 1)):
        overflow = sum(widths) + 2 * (len(widths) - 1) - term_width
        widths[i] -= min(max(0, overflow), widths[i] - minimums[i])
    state_index = headers.index('STATE')
    numeric = {headers.index('IN' if compact else 'IMPORTED'), headers.index('OUT' if compact else 'EXPORTED')}

    def line(cells, state=None, heading=False):
        parts = []
        # On exceptionally narrow terminals, truncate before adding ANSI codes.
        remaining = term_width
        for i, (cell, width) in enumerate(zip(cells, widths)):
            if i:
                gap = ' ' * min(2, remaining)
                parts.append(gap)
                remaining -= len(gap)
            visible = min(width, remaining)
            text = fit(cell, visible)
            text = text.rjust(visible) if i in numeric else text.ljust(visible)
            if state is not None and i == state_index:
                text = colorize(text, 'green' if state == 'established' else
                                'yellow' if state in ('connect', 'active') else 'red', color)
            elif state is not None and i == 0:
                text = colorize(text, 'bold', color)
            elif state is not None and headers[i] == 'ASN':
                text = colorize(text, 'cyan', color)
            elif heading or (state is not None and headers[i] in ('AF', 'SINCE', 'DETAIL')):
                if headers[i] != 'DETAIL' or state in (None, 'established'):
                    text = colorize(text, 'dim', color)
            parts.append(text)
            remaining -= visible
        return ''.join(parts).rstrip()

    lines = [line(headers, heading=True), line(['-' * w for w in widths], heading=True)]
    lines += [line(cells, peer_state(row)) for cells, row in zip(raw, rows)]
    return '\n'.join(lines)


def render(rows: List[Dict[str, str]], color: bool, compact: bool, watch: Optional[float], details: bool = False) -> str:
    up = sum(1 for r in rows if peer_state(r) == 'established')
    down = len(rows) - up
    stamp = time.strftime('%Y-%m-%d %H:%M:%S')
    width = max(1, shutil.get_terminal_size((180, 40)).columns)
    title = colorize(fit('BIRD / Peer summary', width), 'bold', color)
    counts = [f'{len(rows)} peers', f'{up} up', f'{down} down']
    summary = '  /  '.join(counts)
    if len(summary) <= width:
        summary = (f'{counts[0]}  /  ' + colorize(counts[1], 'green', color) +
                   '  /  ' + colorize(counts[2], 'red' if down else 'dim', color))
    else:
        summary = fit(summary, width)
    footer = f'Updated {stamp}'
    if watch:
        footer += f'  /  Refresh {watch:g}s  /  Ctrl+C to exit'
    body = render_rows(rows, color=color, compact=compact, details=details)
    return f"\n{title}\n{summary}\n\n{body}\n\n{colorize(fit(footer, width), 'dim', color)}\n"


def positive_seconds(value):
    try:
        number = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError('must be a positive number of seconds') from None
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError('must be a positive number of seconds')
    return number


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description='Read-only BIRD BGP peer summary. One daemon query per refresh.')
    parser.add_argument('--version', action='version', version=f'%(prog)s {VERSION}')
    states = parser.add_mutually_exclusive_group()
    states.add_argument('--up', action='store_true', help='show established sessions only')
    states.add_argument('--down', action='store_true', help='show sessions that are not established')
    parser.add_argument('--match', metavar='TEXT', help='search names, IPs, ASNs and descriptions (case insensitive)')
    parser.add_argument('--sort', choices=['state', 'name', 'asn', 'imported', 'exported'], default='state',
                        help='sort field; route counts sort largest first (default: state)')
    parser.add_argument('--compact', action='store_true', help='use fewer columns')
    parser.add_argument('--details', action='store_true', help='include source addresses and full peer details')
    parser.add_argument('--no-color', action='store_true', help='disable ANSI colours')
    parser.add_argument('--json', action='store_true', help='emit JSON; with --watch, emit one JSON object per line')
    parser.add_argument('--watch', type=positive_seconds, metavar='SECONDS', help='refresh interval (positive number)')
    parser.add_argument('--timeout', type=positive_seconds, default=10, metavar='SECONDS', help='birdc timeout (default: 10)')
    parser.add_argument('--socket', '-s', metavar='PATH', help='BIRD control socket')
    parser.add_argument('--birdc', metavar='PATH', help='birdc executable (overrides BIRDC)')
    return parser.parse_args(argv)


def json_snapshot(rows):
    peers = []
    for row in rows:
        peer = dict(row)
        peer['session_state'] = peer_state(row)
        for field in ('imported', 'exported', 'preferred'):
            peer[field] = int(peer[field])
        peers.append(peer)
    up = sum(peer_state(row) == 'established' for row in rows)
    return {'generated_at': time.strftime('%Y-%m-%dT%H:%M:%S%z'),
            'summary': {'total': len(rows), 'up': up, 'down': len(rows) - up}, 'peers': peers}


def main(argv=None) -> int:
    args = parse_args(argv)
    tty = sys.stdout.isatty() and os.environ.get('TERM') != 'dumb'
    color = tty and not args.no_color and 'NO_COLOR' not in os.environ
    try:
        while True:
            rows = collect_rows(args)
            if args.json:
                print(json.dumps(json_snapshot(rows), indent=None if args.watch else 2), flush=True)
            else:
                output = render(rows, color=color, compact=args.compact, watch=args.watch, details=args.details)
                if not rows:
                    output += '\n\nNo matching BGP peers found.'
                if args.watch and tty:
                    print('\033[H\033[J', end='')
                print(output, flush=True)
            if not args.watch:
                return 0
            time.sleep(args.watch)
    except BirdError as exc:
        print(f'bps: {exc}', file=sys.stderr)
        return 1
    except (KeyboardInterrupt, BrokenPipeError):
        return 0


if __name__ == '__main__':
    raise SystemExit(main())
